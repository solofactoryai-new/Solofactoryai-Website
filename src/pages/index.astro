---
/* The homepage, dark prototype (website rebuild brief, part 3, 2026-11-22), in the brief's
   order: hero, the future, the problem, the platform and its three layers, how it works, the
   AI workforce, the connected Brain, the founder, the ambition, and early access. */
import Base from "../layouts/Base.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Ambition from "../components/home/Ambition.astro";
import ConnectedBrain from "../components/home/ConnectedBrain.astro";
import Founder from "../components/home/Founder.astro";
import Future from "../components/home/Future.astro";
import Hero from "../components/home/Hero.astro";
import Journey from "../components/home/Journey.astro";
import Platform from "../components/home/Platform.astro";
import Problem from "../components/home/Problem.astro";
import Workforce from "../components/home/Workforce.astro";
---

<Base
  title="SoloFactory AI — Build Your Business. Not Your Team."
  description="One entrepreneur. One connected Brain. An entire AI workforce. Discover how SoloFactory AI is building a new way to turn ideas into businesses."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Nav />
  <main id="main">
    <Hero />
    <Future />
    <Problem />
    <Platform />
    <Journey />
    <Workforce />
    <ConnectedBrain />
    <Founder />
    <Ambition />
    <FinalCta />
  </main>
  <Footer />
  <script>
    // Sections fade in once as they scroll into view. Without scripts, or with reduced motion,
    // everything is simply visible.
    const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      items.forEach((el) => observer.observe(el));
    }

    // Analytics hooks (brief 6.5). No analytics tool is installed: links marked data-track
    // only announce a "sf:track" event on the page, ready for whichever tool is chosen later.
    document.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>("[data-track]");
      if (el) window.dispatchEvent(new CustomEvent("sf:track", { detail: { event: el.dataset.track } }));
    });
  </script>
</Base>
