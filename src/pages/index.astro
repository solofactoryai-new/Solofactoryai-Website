---
import Base from "../layouts/Base.astro";
import Ecosystem from "../components/Ecosystem.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Journey from "../components/Journey.astro";
import Nav from "../components/Nav.astro";
import Ownership from "../components/Ownership.astro";
import Problem from "../components/Problem.astro";
import Solution from "../components/Solution.astro";
import Vision from "../components/Vision.astro";
import Workforce from "../components/Workforce.astro";
---

<Base
  title="SoloFactory AI | Build Your Business. Not Your Team."
  description="SoloFactory AI is an AI-powered business operating system for independent entrepreneurs: one intelligent Brain and an AI workforce to build, operate and grow a sustainable business."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <Solution />
    <Journey />
    <Workforce />
    <Ecosystem />
    <Ownership />
    <Vision />
    <FinalCta />
  </main>
  <Footer />
  <script>
    // Sections fade in once as they scroll into view. Without scripts, or with reduced motion,
    // everything is simply visible.
    const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      items.forEach((el) => observer.observe(el));
    }
  </script>
</Base>
