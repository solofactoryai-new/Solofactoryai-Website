---
/* Source of public/og.png, the 1200 x 630 social sharing image (README, "The social
   image"). Product style: the black top bar with the logo, then a white page. Not linked from
   the site and not indexed. */
import "@fontsource-variable/inter";
import Logo from "../components/Logo.astro";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>SoloFactory AI social card</title>
  </head>
  <body>
    <div class="card">
      <div class="bar"><Logo class="brand" /></div>
      <div class="body">
        <div class="copy">
          <p class="label">Our vision</p>
          <h1>Imagine a world where anyone can own a company <span>that pays them.</span></h1>
          <p class="tag">Build Your Business. Not Your Team.</p>
        </div>
        <img class="icon" src="/brand/icon-512.png" alt="" width="220" height="220" />
      </div>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #fff;
  }
</style>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    box-sizing: border-box;
    background: #fff;
    color: #171717;
    font-family: "Inter Variable", system-ui, sans-serif;
  }

  .bar {
    display: flex;
    align-items: center;
    height: 96px;
    padding: 0 72px;
    background: #080808;
    color: #fff;
  }

  .card :global(.logo__mark) {
    width: 36px;
    height: 36px;
  }

  .card :global(.logo__word) {
    font-size: 28px;
  }

  .body {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
    padding: 0 72px;
  }

  .label {
    margin: 0;
    color: #636363;
    font-size: 24px;
    font-weight: 550;
  }

  h1 {
    max-width: 15em;
    margin: 16px 0 0;
    font-size: 60px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  h1 span {
    color: #636363;
  }

  .tag {
    margin: 32px 0 0;
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .icon {
    flex: none;
    width: 220px;
    height: 220px;
  }
</style>
