---
/* The opening of every inner page: a small label, one large headline and a short lead. */
interface Props {
  eyebrow: string;
  title: string;
  soft?: string;
  lead?: string;
}
const { eyebrow, title, soft, lead } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title" id="page-title">
      {title}{soft && <> <span class="soft">{soft}</span></>}
    </h1>
    {lead && <p class="lead page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(56px, 8vw, 112px) 0 clamp(48px, 6vw, 88px);
    border-bottom: 1px solid var(--border);
  }

  .page-hero__title {
    max-width: 20ch;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .page-hero__lead {
    margin-top: 28px;
  }
</style>
