---
/* The closing call to action on every page: the brief's final message and the two actions. */
import Icon from "../Icon.astro";
import { routes } from "../../config/site";

interface Props {
  secondary?: { href: string; label: string };
  track?: string;
}
const { secondary = { href: routes.platform, label: "Explore the Platform" }, track = "cta_band" } =
  Astro.props;
---

<section class="section cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__inner" data-reveal>
    <p class="eyebrow">Start your journey</p>
    <h2 class="cta-band__title" id="cta-band-title">The future belongs to those who build.</h2>
    <p class="lead cta-band__lead">
      You have an idea. You have an ambition. You have something worth creating. We are building
      a new way to turn that ambition into a business.
    </p>
    <div class="cta-band__actions">
      <a class="button" href={routes.earlyAccess} data-track={`${track}_early_access`}>Get Early Access <Icon name="arrow-right" /></a>
      <a class="button button--secondary" href={secondary.href} data-track={`${track}_secondary`}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--bg-secondary);
  }

  .cta-band__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .cta-band__title {
    max-width: 16ch;
    font-size: clamp(36px, 5.4vw, 72px);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .cta-band__lead {
    margin-top: 24px;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
