---
/* The black top bar, as in the product (PRD 2.10): the white logo, white links that turn
   #1F1F1F on hover, and nothing else in black on the page. */
import Logo from "./Logo.astro";

const links = [
  { href: "#vision", label: "Vision" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#workforce", label: "AI Workforce" },
  { href: "#ecosystem", label: "Ecosystem" },
];
---

<header class="topbar" data-nav>
  <div class="container topbar__inner">
    <a class="topbar__brand" href="#top" aria-label="SoloFactory AI, back to the top"><Logo /></a>
    <nav class="topbar__menu" id="nav-menu" aria-label="Main">
      <ul class="topbar__links">
        {links.map((link) => <li><a class="topbar__link" href={link.href}>{link.label}</a></li>)}
      </ul>
      <a class="topbar__cta" href="#join">Join Waitlist</a>
    </nav>
    <button
      class="topbar__toggle"
      type="button"
      aria-controls="nav-menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <span data-nav-label>Menu</span>
    </button>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const label = document.querySelector<HTMLElement>("[data-nav-label]");

  const setOpen = (open: boolean) => {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Close" : "Menu";
  };

  toggle?.addEventListener("click", () => setOpen(!nav?.classList.contains("is-open")));
  nav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav?.classList.contains("is-open")) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--topbar);
    color: var(--topbar-text);
  }

  .topbar :focus-visible {
    outline-color: var(--topbar-text);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--topbar-height);
  }

  .topbar__brand {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--topbar-text);
    text-decoration: none;
  }

  .topbar__menu {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .topbar__links {
    display: flex;
    gap: 4px;
  }

  .topbar__link,
  .topbar__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--topbar-text);
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .topbar__link:hover,
  .topbar__toggle:hover,
  .topbar__toggle[aria-expanded="true"] {
    background: var(--topbar-hover);
  }

  /* The one call to action in the bar: white, so it stands out on black. */
  .topbar__cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-md);
    background: var(--topbar-text);
    color: var(--text);
    font-size: 15px;
    font-weight: 550;
    text-decoration: none;
  }

  .topbar__cta:hover {
    background: var(--hover);
  }

  .topbar__cta:focus-visible {
    outline-offset: 3px;
  }

  .topbar__toggle {
    display: none;
    min-height: 44px;
  }

  @media (max-width: 860px) {
    .topbar__toggle {
      display: inline-flex;
    }

    .topbar__menu {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      max-height: calc(100vh - var(--topbar-height));
      overflow-y: auto;
      padding: 8px var(--gutter) 20px;
      background: var(--topbar);
    }

    .topbar__links {
      flex-direction: column;
      gap: 2px;
    }

    .topbar__link {
      width: 100%;
      min-height: 44px;
    }

    .topbar__cta {
      justify-content: center;
      min-height: 48px;
    }

    .topbar.is-open .topbar__menu {
      display: flex;
    }
  }
</style>
