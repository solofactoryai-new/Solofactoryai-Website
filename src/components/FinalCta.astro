---
import Icon from "./Icon.astro";

/* Where the form sends its JSON. Empty until a service is chosen (README, "The early-access
   form"): the form then validates but says honestly that sign-up is not connected yet. */
const endpoint = (import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? "").trim();

const businessTypes = [
  "Software or SaaS",
  "AI product",
  "Physical product or hardware",
  "Ecommerce or D2C",
  "Consulting or professional services",
  "Agency",
  "Manufacturing",
  "Other",
];
---

<section class="section section--grey join" id="join" aria-labelledby="join-title">
  <div class="container join__grid">
    <div class="join__copy" data-reveal>
      <p class="eyebrow">Join the journey</p>
      <h2 class="h2" id="join-title">
        Your Business. Your Ownership. <span class="soft">Your Future.</span>
      </h2>
      <p class="lead">
        The next generation of entrepreneurs won't need to build traditional teams to build
        meaningful businesses. They'll have AI on their side.
      </p>
      <p class="join__line">Be among the entrepreneurs shaping the future of one-person businesses.</p>
    </div>

    <form
      class="join__form"
      data-waitlist
      data-endpoint={endpoint}
      action={endpoint || undefined}
      method="post"
      aria-labelledby="join-form-title"
      data-reveal
    >
      <h3 class="h3" id="join-form-title">Join the SoloFactory AI Journey</h3>
      <p class="muted join__intro">Get early access as new parts of the platform open.</p>

      <div class="field">
        <label for="wl-name">Name</label>
        <input id="wl-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="wl-name-error" />
        <p class="field__error" id="wl-name-error" data-error-for="name"></p>
      </div>

      <div class="field">
        <label for="wl-email">Email</label>
        <input id="wl-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="wl-email-error" />
        <p class="field__error" id="wl-email-error" data-error-for="email"></p>
      </div>

      <div class="field">
        <label for="wl-type">Business type</label>
        <div class="field__select">
          <select id="wl-type" name="businessType" required aria-describedby="wl-type-error">
            <option value="" selected disabled>Choose one</option>
            {businessTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>
        <p class="field__error" id="wl-type-error" data-error-for="businessType"></p>
      </div>

      <div class="field">
        <label for="wl-website">Website <span class="field__optional">(optional)</span></label>
        <input id="wl-website" name="website" type="url" autocomplete="url" inputmode="url" maxlength="200" placeholder="https://" aria-describedby="wl-website-error" />
        <p class="field__error" id="wl-website-error" data-error-for="website"></p>
      </div>

      <div class="field field--trap" aria-hidden="true">
        <label for="wl-company">Leave this empty</label>
        <input id="wl-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="button join__submit" type="submit" data-submit>
        <span data-submit-label>Join the SoloFactory AI Journey</span>
        <Icon name="arrow-right" />
      </button>

      <p class="join__status" role="status" aria-live="polite" data-status></p>
      <p class="join__privacy">
        We use your details only to contact you about early access to SoloFactory AI.
      </p>
    </form>
  </div>
</section>

<script>
  import { initWaitlist } from "../scripts/waitlist";
  document.querySelectorAll<HTMLFormElement>("[data-waitlist]").forEach(initWaitlist);
</script>

<style>
  .join__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .join__copy {
    display: grid;
    gap: 22px;
  }

  .join__line {
    color: var(--text);
    font-weight: 600;
  }

  .join__form {
    display: grid;
    gap: 18px;
    padding: clamp(28px, 4vw, 44px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow: var(--shadow-1);
  }

  .join__intro {
    margin-top: -10px;
    font-size: 15px;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  .field label {
    font-size: 14px;
    font-weight: 600;
  }

  .field__optional {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 50px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 16px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .field__select {
    position: relative;
  }

  .field__select::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 18px;
    width: 8px;
    height: 8px;
    border-right: 1.75px solid var(--text-secondary);
    border-bottom: 1.75px solid var(--text-secondary);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field select {
    padding-right: 44px;
    appearance: none;
    -webkit-appearance: none;
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--text);
    outline: 2px solid var(--text);
    outline-offset: 0;
  }

  .field input[aria-invalid="true"],
  .field select[aria-invalid="true"] {
    border-color: var(--danger);
  }

  .field__error {
    color: #b42318;
    font-size: 14px;
  }

  .field__error:empty {
    display: none;
  }

  .field--trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .join__submit {
    margin-top: 6px;
  }

  .join__submit[disabled] {
    cursor: progress;
    opacity: 0.7;
  }

  .join__status:empty {
    display: none;
  }

  .join__status {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--bg-secondary);
    font-size: 15px;
  }

  .join__status[data-tone="success"] {
    background: #ecfdf3;
    color: #05603a;
  }

  .join__status[data-tone="error"] {
    background: #fef3f2;
    color: #b42318;
  }

  .join__status[data-tone="info"] {
    background: var(--bg-secondary);
    color: var(--text);
  }

  .join__privacy {
    color: var(--text-secondary);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .join__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
