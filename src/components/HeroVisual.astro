---
/* Concept illustration (not a product screenshot): one entrepreneur at the centre, inside the
   Business Brain, connected to seven specialised AI Workers. Lines and rings are one SVG in a
   0-100 space; the labels are HTML placed on the same coordinates, so they stay readable at
   every width. */
import Icon, { type IconName } from "./Icon.astro";

const workers: { label: string; icon: IconName }[] = [
  { label: "Research", icon: "search" },
  { label: "Product", icon: "package" },
  { label: "Marketing", icon: "megaphone" },
  { label: "Sales", icon: "target" },
  { label: "Finance", icon: "wallet" },
  { label: "Operations", icon: "workflow" },
  { label: "Customer Support", icon: "life-buoy" },
];

const RADIUS = 40;
const placed = workers.map((worker, i) => {
  const angle = (-90 + (i * 360) / workers.length) * (Math.PI / 180);
  const x = 50 + RADIUS * Math.cos(angle);
  const y = 50 + RADIUS * Math.sin(angle);
  return { ...worker, x: Number(x.toFixed(2)), y: Number(y.toFixed(2)), delay: i * 0.45 };
});
---

<figure class="orbit" aria-label="Concept illustration: one entrepreneur at the centre of an intelligent Business Brain, connected to AI Workers for research, product, marketing, sales, finance, operations and customer support.">
  <svg class="orbit__lines" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="brain-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#171717" stop-opacity="0.07" />
        <stop offset="1" stop-color="#171717" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="50" cy="50" r="30" fill="url(#brain-glow)" class="orbit__glow" />
    <circle cx="50" cy="50" r={RADIUS} class="orbit__path" />
    <circle cx="50" cy="50" r="19" class="orbit__brain" />
    <circle cx="50" cy="50" r="19" class="orbit__brain-dash" />
    {placed.map((w) => (
      <line x1="50" y1="50" x2={w.x} y2={w.y} class="orbit__link" style={`animation-delay:-${w.delay}s`} />
    ))}
  </svg>

  <div class="orbit__core">
    <span class="orbit__you"><Icon name="user" size={26} /></span>
    <span class="orbit__core-label">You</span>
  </div>
  <span class="orbit__brain-label">The Brain</span>

  <ul class="orbit__workers">
    {placed.map((w) => (
      <li class="orbit__worker" style={`--x:${w.x}%;--y:${w.y}%;--d:${w.delay}s`}>
        <span class="orbit__worker-icon"><Icon name={w.icon} size={18} /></span>
        <span class="orbit__worker-label">{w.label}</span>
      </li>
    ))}
  </ul>
  <figcaption class="orbit__caption">Concept illustration</figcaption>
</figure>

<style>
  /* Drawn in the product's colours: black, white and greys. */
  .orbit {
    position: relative;
    width: 100%;
    max-width: 540px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .orbit__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit__path {
    fill: none;
    stroke: var(--border);
    stroke-width: 0.3;
  }

  .orbit__brain {
    fill: var(--bg-secondary);
    stroke: var(--text);
    stroke-width: 0.35;
  }

  .orbit__brain-dash {
    fill: none;
    stroke: #8a8a8a;
    stroke-width: 0.5;
    stroke-dasharray: 0.5 3.5;
    transform-origin: 50% 50%;
    animation: spin 80s linear infinite;
  }

  .orbit__glow {
    transform-origin: 50% 50%;
    animation: breathe 6s ease-in-out infinite;
  }

  .orbit__link {
    stroke: #b8b8b8;
    stroke-width: 0.25;
    stroke-dasharray: 1 1.6;
    animation: flow 3.6s linear infinite;
  }

  .orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 6px;
    transform: translate(-50%, -50%);
  }

  .orbit__you {
    display: grid;
    width: clamp(48px, 12%, 64px);
    aspect-ratio: 1 / 1;
    place-items: center;
    border-radius: 50%;
    background: var(--action);
    color: #fff;
    box-shadow: var(--shadow-2);
  }

  .orbit__core-label {
    font-size: 13px;
    font-weight: 600;
  }

  .orbit__brain-label {
    position: absolute;
    top: 27.5%;
    left: 50%;
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 550;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .orbit__worker {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 30%;
    padding: 6px 12px 6px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    font-weight: 550;
    line-height: 1.15;
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-1);
    animation: float 7s ease-in-out infinite;
    animation-delay: calc(var(--d) * -1);
  }

  .orbit__worker-icon {
    display: grid;
    width: 28px;
    height: 28px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-secondary);
    color: var(--text);
  }

  .orbit__worker-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .orbit__caption {
    position: absolute;
    right: 0;
    bottom: -8px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -5.2;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 4px));
    }
  }

  @media (max-width: 520px) {
    /* Room for the outer labels, which sit half outside the circle. */
    .orbit {
      width: 78%;
    }

    .orbit__worker {
      gap: 6px;
      max-width: 34%;
      padding: 5px 9px 5px 5px;
      font-size: 12px;
    }

    .orbit__worker-icon {
      width: 22px;
      height: 22px;
    }

    .orbit__worker-icon :global(svg) {
      width: 13px;
      height: 13px;
    }

    .orbit__brain-label {
      font-size: 10px;
    }
  }
</style>
