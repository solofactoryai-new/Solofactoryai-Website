---
/* Concept illustration (not a product screenshot): one entrepreneur at the centre, inside the
   Business Brain, connected to seven specialised AI Workers. Lines and rings are one SVG in a
   0-100 space; the labels are HTML placed on the same coordinates, so they stay readable at
   every width. */
import Icon, { type IconName } from "./Icon.astro";

const workers: { label: string; icon: IconName }[] = [
  { label: "Research", icon: "search" },
  { label: "Product", icon: "package" },
  { label: "Marketing", icon: "megaphone" },
  { label: "Sales", icon: "target" },
  { label: "Finance", icon: "wallet" },
  { label: "Operations", icon: "workflow" },
  { label: "Customer Support", icon: "life-buoy" },
];

const RADIUS = 40;
const placed = workers.map((worker, i) => {
  const angle = (-90 + (i * 360) / workers.length) * (Math.PI / 180);
  const x = 50 + RADIUS * Math.cos(angle);
  const y = 50 + RADIUS * Math.sin(angle);
  return { ...worker, x: Number(x.toFixed(2)), y: Number(y.toFixed(2)), delay: i * 0.45 };
});
---

<figure class="orbit" aria-label="Concept illustration: one entrepreneur at the centre of an intelligent Business Brain, connected to AI Workers for research, product, marketing, sales, finance, operations and customer support.">
  <svg class="orbit__lines" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="brain-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#6d7bff" stop-opacity="0.55" />
        <stop offset="0.55" stop-color="#8b5cf6" stop-opacity="0.18" />
        <stop offset="1" stop-color="#8b5cf6" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="ring" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#7c8bff" />
        <stop offset="1" stop-color="#c4b5fd" />
      </linearGradient>
      <linearGradient id="link" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#7c8bff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#7c8bff" stop-opacity="0.15" />
      </linearGradient>
    </defs>
    <circle cx="50" cy="50" r="28" fill="url(#brain-glow)" class="orbit__glow" />
    <circle cx="50" cy="50" r={RADIUS} class="orbit__path" />
    <circle cx="50" cy="50" r="19" class="orbit__brain" />
    <circle cx="50" cy="50" r="19" class="orbit__brain-dash" />
    {placed.map((w) => (
      <line x1="50" y1="50" x2={w.x} y2={w.y} class="orbit__link" style={`animation-delay:-${w.delay}s`} />
    ))}
  </svg>

  <div class="orbit__core">
    <span class="orbit__you"><Icon name="user" size={26} /></span>
    <span class="orbit__core-label">You</span>
  </div>
  <span class="orbit__brain-label">The Brain</span>

  <ul class="orbit__workers">
    {placed.map((w) => (
      <li class="orbit__worker" style={`--x:${w.x}%;--y:${w.y}%;--d:${w.delay}s`}>
        <span class="orbit__worker-icon"><Icon name={w.icon} size={18} /></span>
        <span class="orbit__worker-label">{w.label}</span>
      </li>
    ))}
  </ul>
  <figcaption class="orbit__caption">Concept illustration</figcaption>
</figure>

<style>
  .orbit {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .orbit__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit__path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 0.3;
  }

  .orbit__brain {
    fill: rgba(17, 26, 53, 0.65);
    stroke: url(#ring);
    stroke-width: 0.45;
  }

  .orbit__brain-dash {
    fill: none;
    stroke: rgba(196, 181, 253, 0.55);
    stroke-width: 0.6;
    stroke-dasharray: 0.6 3.4;
    transform-origin: 50% 50%;
    animation: spin 60s linear infinite;
  }

  .orbit__glow {
    transform-origin: 50% 50%;
    animation: breathe 6s ease-in-out infinite;
  }

  .orbit__link {
    stroke: url(#link);
    stroke-width: 0.28;
    stroke-dasharray: 1.2 1.6;
    animation: flow 3.2s linear infinite;
  }

  .orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 6px;
    transform: translate(-50%, -50%);
  }

  .orbit__you {
    display: grid;
    width: clamp(52px, 13%, 68px);
    aspect-ratio: 1 / 1;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 0 0 6px rgba(124, 139, 255, 0.18),
      0 12px 40px -6px rgba(124, 139, 255, 0.6);
  }

  .orbit__core-label {
    color: var(--text-on-dark);
    font-size: 13px;
    font-weight: 600;
  }

  .orbit__brain-label {
    position: absolute;
    top: 28%;
    left: 50%;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(124, 139, 255, 0.14);
    color: #c7ccff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .orbit__worker {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 30%;
    padding: 8px 12px 8px 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(17, 26, 53, 0.92);
    color: var(--text-on-dark);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.15;
    transform: translate(-50%, -50%);
    box-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.8);
    animation: float 7s ease-in-out infinite;
    animation-delay: calc(var(--d) * -1);
  }

  .orbit__worker-icon {
    display: grid;
    width: 30px;
    height: 30px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: rgba(124, 139, 255, 0.16);
    color: #b9c0ff;
  }

  .orbit__caption {
    position: absolute;
    right: 0;
    bottom: -6px;
    color: rgba(166, 174, 200, 0.7);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -5.6;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 5px));
    }
  }

  @media (max-width: 520px) {
    /* Room for the outer labels, which sit half outside the circle. */
    .orbit {
      width: 78%;
    }

    .orbit__worker {
      gap: 6px;
      max-width: 34%;
      padding: 6px 9px 6px 6px;
      font-size: 12px;
    }

    .orbit__worker-icon {
      width: 24px;
      height: 24px;
    }

    .orbit__worker-icon :global(svg) {
      width: 14px;
      height: 14px;
    }

    .orbit__brain-label {
      top: 27%;
      font-size: 10px;
    }
  }
</style>
