---
/* The SoloFactory AI logo: the V4 "Architectural" five-blade mark from the founder's logo deck,
   chosen for the website on 2026-11-20, beside the wordmark. The mark is drawn from
   /brand/mark.png as a mask, so it takes the colour of the text around it: white in the black
   top bar, near-black on light backgrounds. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__word">SoloFactory AI</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .logo__mark {
    flex: none;
    width: 24px;
    height: 24px;
    background: currentColor;
    -webkit-mask: url("/brand/mark.png") center / contain no-repeat;
    mask: url("/brand/mark.png") center / contain no-repeat;
  }

  .logo__word {
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
</style>
