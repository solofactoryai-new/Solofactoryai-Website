---
/* The SoloFactory AI wordmark with its mark: one centre (the entrepreneur) inside the orbit of
   the Brain, with the workforce as points on the ring. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#6d7bff" />
        <stop offset="1" stop-color="#a78bfa" />
      </linearGradient>
    </defs>
    <circle cx="16" cy="16" r="12.5" fill="none" stroke="url(#logo-grad)" stroke-width="2" />
    <circle cx="16" cy="16" r="4.5" fill="url(#logo-grad)" />
    <circle cx="16" cy="3.5" r="2.2" fill="#fff" />
    <circle cx="26.8" cy="22.3" r="2.2" fill="#fff" />
    <circle cx="5.2" cy="22.3" r="2.2" fill="#fff" />
  </svg>
  <span class="logo__text">SoloFactory <span class="logo__ai">AI</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo__mark {
    width: 28px;
    height: 28px;
    flex: none;
  }

  .logo__ai {
    font-weight: 500;
    opacity: 0.85;
  }
</style>
