---
import Icon, { type IconName } from "./Icon.astro";

const steps: { name: string; text: string; icon: IconName }[] = [
  { name: "Discover", text: "Find meaningful opportunities and customer problems.", icon: "compass" },
  { name: "Validate", text: "Refine the problem, ICP and business hypothesis.", icon: "circle-check" },
  { name: "Build", text: "Develop the right product or service.", icon: "wrench" },
  { name: "Connect", text: "Find prospects and arrange customer conversations.", icon: "message" },
  { name: "Acquire", text: "Convert prospects into paying customers.", icon: "credit-card" },
  { name: "Operate", text: "Manage business activities and workflows.", icon: "workflow" },
  { name: "Grow", text: "Increase revenue and reach more customers.", icon: "trending-up" },
  { name: "Sustain", text: "Build a financially sustainable business.", icon: "sprout" },
];
---

<section class="section dark journey" aria-labelledby="journey-title">
  <div class="journey__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The entrepreneur journey</p>
      <h2 class="h2" id="journey-title">
        From Idea to a <span class="serif">Sustainable Business.</span>
      </h2>
      <p class="lead">
        One connected path, whatever you are building. The Brain remembers every step, so each
        stage builds on what you have already learned.
      </p>
    </div>

    <ol class="journey__steps">
      {steps.map((step, i) => (
        <li class="journey__step" data-reveal style={`transition-delay:${i * 60}ms`}>
          <span class="journey__marker">
            <Icon name={step.icon} size={20} />
          </span>
          <div class="journey__body">
            <p class="journey__num">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="h3">{step.name}</h3>
            <p class="muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey {
    overflow: hidden;
  }

  .journey__glow {
    position: absolute;
    right: -10%;
    bottom: -30%;
    width: 60%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.2), transparent);
    pointer-events: none;
  }

  .journey__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 16px;
  }

  .journey__steps::before {
    content: "";
    position: absolute;
    top: 22px;
    right: 6%;
    left: 6%;
    height: 1px;
    background: linear-gradient(90deg, #6d7bff, #a78bfa 60%, rgba(167, 139, 250, 0.2));
  }

  .journey__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 18px;
  }

  .journey__marker {
    position: relative;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.45);
    border-radius: 50%;
    background: var(--ink);
    color: #c7ccff;
  }

  .journey__num {
    color: #a5acff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .journey__body {
    display: grid;
    gap: 6px;
  }

  .journey__body .muted {
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 1080px) {
    .journey__steps {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 560px;
    }

    .journey__steps::before {
      top: 22px;
      bottom: 22px;
      left: 22px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, #6d7bff, #a78bfa 60%, rgba(167, 139, 250, 0.2));
    }

    .journey__step {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 20px;
      padding-bottom: 32px;
    }

    .journey__step:last-child {
      padding-bottom: 0;
    }

    .journey__body {
      padding-top: 2px;
    }
  }
</style>
