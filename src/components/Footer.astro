---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const links = [
  { href: "#vision", label: "Vision" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#workforce", label: "AI Workforce" },
  { href: "#ecosystem", label: "Ecosystem" },
  { href: "#join", label: "Join Waitlist" },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo />
      <p class="muted">One entrepreneur. One connected Brain. An entire AI workforce.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container footer__base">
    <p>© {year} SoloFactory AI. All rights reserved.</p>
    <p>Illustrations on this page show concepts, not screenshots of the product.</p>
  </div>
  <!-- A large, quiet sign-off logo at the very end of the page. Decorative: the logo above
       already names the company for screen readers. -->
  <div class="container footer__giant" aria-hidden="true">
    <div class="footer__giant-row">
      <span class="footer__giant-mark"></span>
      <span class="footer__giant-word">SoloFactory AI</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 64px 0 32px;
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  .footer__brand {
    display: grid;
    gap: 14px;
  }

  .footer__brand .muted {
    font-size: 15px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer__links a {
    color: var(--text-secondary);
    font-size: 15px;
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 13px;
  }

  .footer__giant {
    container-type: inline-size;
    margin-top: clamp(40px, 6vw, 72px);
    user-select: none;
  }

  /* Sized against the container's width (cqi), so the row fills it at every screen size. */
  .footer__giant-row {
    display: flex;
    align-items: center;
    gap: 0.16em;
    color: #dcdcdc;
    font-size: 13.2cqi;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .footer__giant-mark {
    flex: none;
    width: 0.86em;
    height: 0.86em;
    background: currentColor;
    -webkit-mask: url("/brand/mark.png") center / contain no-repeat;
    mask: url("/brand/mark.png") center / contain no-repeat;
  }
</style>
