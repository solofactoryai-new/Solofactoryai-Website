---
/* The footer, on light grey as in the product: the logo and mission, links to the homepage
   sections, and the closing statement. Only links that lead somewhere real: no privacy, terms
   or social links until those pages and accounts exist (brief: footer). */
import Logo from "./Logo.astro";
import { routes } from "../config/site";

const year = new Date().getFullYear();
const groups = [
  {
    title: "Platform",
    links: [
      { href: routes.platform, label: "Platform" },
      { href: routes.howItWorks, label: "How It Works" },
      { href: routes.workforce, label: "AI Workforce" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: routes.vision, label: "Our Vision" },
      { href: routes.about, label: "About" },
      { href: routes.earlyAccess, label: "Early Access" },
      { href: routes.privacy, label: "Privacy" },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <Logo />
        <p class="footer__statement">The future belongs to those who build.</p>
        <p class="muted">
          Making sustainable business ownership accessible to more people, with a connected Brain
          and an AI workforce.
        </p>
      </div>
      {groups.map((g) => (
        <nav class="footer__group" aria-label={g.title}>
          <p class="footer__title">{g.title}</p>
          <ul>
            {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer__base">
      <p>© {year} SoloFactory AI. All rights reserved.</p>
      <p>One entrepreneur. One connected Brain. An entire AI workforce.</p>
      <p>Illustrations show concepts, not screenshots of the product.</p>
    </div>
  </div>

  <!-- A large, quiet sign-off logo. Decorative: the logo above already names the company. -->
  <div class="container footer__giant" aria-hidden="true">
    <div class="footer__giant-row">
      <span class="footer__giant-mark"></span>
      <span class="footer__giant-word">SoloFactory AI</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(64px, 8vw, 104px) 0 0;
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .footer__statement {
    color: var(--text);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 16px;
    max-width: 40ch;
  }

  .footer__brand .muted {
    font-size: 15px;
  }

  .footer__title {
    margin-bottom: 14px;
    color: var(--text-tertiary);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__group ul {
    display: grid;
    gap: 10px;
  }

  .footer__group a {
    color: var(--text-secondary);
    font-size: 15px;
    text-decoration: none;
  }

  .footer__group a:hover {
    color: var(--text);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .footer__giant {
    container-type: inline-size;
    overflow: hidden;
    margin-top: 32px;
    color: #dcdcdc;
  }

  .footer__giant-row {
    display: flex;
    align-items: center;
    gap: 0.18em;
    font-size: 13.2cqi;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    transform: translateY(18%);
  }

  .footer__giant-mark {
    flex: none;
    width: 0.82em;
    height: 0.82em;
    background: currentColor;
    -webkit-mask: url("/brand/mark.png") center / contain no-repeat;
    mask: url("/brand/mark.png") center / contain no-repeat;
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
