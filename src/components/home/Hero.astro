---
/* Section 1. The world we are building towards first (the 10-year view), then what
   SoloFactory is, then the two actions. The vision joins the founder's own line ("a company
   that pays them") with the brief's ("build and own a sustainable business"), as the founder
   asked on 2026-11-22. */
import Icon from "../Icon.astro";
import BrainVisual from "./BrainVisual.astro";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">The future of entrepreneurship</p>
      <h1 class="display hero__title" id="hero-title">
        Build Your Business. <span class="hero__title-soft">Not Your Team.</span>
      </h1>
      <p class="hero__tagline">One entrepreneur. One connected Brain. An entire AI workforce.</p>

      <div class="hero__vision">
        <p>
          Imagine a world where anyone with a meaningful idea can build and own a sustainable
          business. A company that pays them.
        </p>
        <p class="hero__lines">
          <span>With or without a job.</span>
          <span>With or without a team.</span>
          <span>With the leverage of AI.</span>
        </p>
      </div>

      <p class="hero__body">
        SoloFactory AI connects your business context, your decisions and a workforce of
        specialised AI Workers, to help you turn an idea into a business with greater
        independence.
      </p>

      <div class="hero__ctas">
        <a class="button" href="#join" data-track="cta_hero_early_access">Get Early Access <Icon name="arrow-right" /></a>
        <a class="button button--secondary" href="#platform" data-track="cta_hero_platform">Explore the Platform</a>
      </div>
      <p class="hero__closing">You bring the ambition. We'll help you build the capabilities.</p>
    </div>

    <div class="hero__visual">
      <BrainVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vw, 112px) 0 clamp(72px, 9vw, 128px);
    border-bottom: 1px solid var(--border);
  }

  /* A faint grid fading out from the centre: depth without decoration noise. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 0%, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(40px, 5vw, 80px);
  }

  .hero__title {
    max-width: 12ch;
  }

  .hero__title-soft {
    display: block;
    color: var(--text-secondary);
  }

  .hero__tagline {
    margin-top: 24px;
    color: var(--text);
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .hero__vision {
    display: grid;
    gap: 12px;
    max-width: 52ch;
    margin-top: 32px;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
  }

  .hero__lines {
    display: grid;
    color: var(--text-secondary);
  }

  .hero__body {
    max-width: 56ch;
    margin-top: 24px;
    color: var(--text-secondary);
    font-size: 17px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__closing {
    margin-top: 24px;
    color: var(--text-tertiary);
    font-size: 15px;
  }

  @media (max-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }
  }
</style>
