---
/* Section 1. The message ladder the founder chose on 2026-11-22:
   1. the dream, as large as the page allows: "Imagine a world where anyone can own a company
      that pays them." (a vision, never a promise of income: it always starts with "Imagine");
   2. how it becomes real: one person and an AI workforce;
   3. the brand promise: "Build Your Business. Not Your Team."
   The headline spans the full width; the Brain picture sits beside the supporting lines. */
import Icon from "../Icon.astro";
import BrainVisual from "./BrainVisual.astro";
import { routes } from "../../config/site";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="eyebrow">Our vision</p>
    <h1 class="hero__title" id="hero-title">
      Imagine a world where anyone can own a company <span class="hero__title-soft">that pays them.</span>
    </h1>

    <div class="hero__row">
      <div class="hero__copy">
        <p class="hero__sub">
          A world where a single person with an idea can build, launch and operate a business
          with the help of an AI workforce.
        </p>
        <p class="hero__brand">Build Your Business. Not Your Team.</p>
        <div class="hero__ctas">
          <a class="button" href={routes.earlyAccess} data-track="cta_hero_early_access">Get Early Access <Icon name="arrow-right" /></a>
          <a class="button button--secondary" href={routes.platform} data-track="cta_hero_platform">Explore the Platform</a>
        </div>
        <p class="hero__closing">One entrepreneur. One connected Brain. An entire AI workforce.</p>
      </div>

      <div class="hero__visual">
        <BrainVisual />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 5vw, 72px) 0 clamp(64px, 8vw, 112px);
    border-bottom: 1px solid var(--border);
  }

  /* A faint grid fading out from the centre: depth without decoration noise. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 60%, #000 0%, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 60% at 70% 60%, #000 0%, transparent 70%);
    opacity: 0.6;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  /* The dream: the largest words on the site. */
  .hero__title {
    max-width: 17ch;
    font-size: clamp(42px, 7vw, 96px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero__title-soft {
    color: var(--text-secondary);
  }

  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(28px, 3vw, 44px);
  }

  .hero__sub {
    max-width: 30ch;
    color: var(--text);
    font-size: clamp(22px, 2.3vw, 30px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .hero__brand {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero__closing {
    margin-top: 20px;
    color: var(--text-tertiary);
    font-size: 15px;
  }

  .hero__visual {
    width: 100%;
    max-width: 480px;
    justify-self: center;
  }

  @media (max-width: 900px) {
    .hero__row {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 440px;
    }
  }
</style>
