---
import Icon from "../Icon.astro";
import { routes } from "../../config/site";

/* Section 9: why the founder is building SoloFactory AI, in the founder's own words
   (2026-11-20; kept exactly, the founder confirmed on 2026-11-22). Only facts the founder gave.
   This is also the "counter-vision": what happens when the problem stays unsolved. */
---

<section class="section founder" id="founder" aria-labelledby="founder-title">
  <div class="container founder__inner">
    <div class="founder__side" data-reveal>
      <figure class="founder__photo">
        <img
          src="/founder/rajesh-dayalan.webp"
          alt="Rajesh Dayalan, founder of SoloFactory AI"
          width="1024"
          height="1536"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="founder__copy" data-reveal>
      <p class="eyebrow">Why we are building this</p>
      <h2 class="h2" id="founder-title">
        I've lived the problem <span class="soft">we're solving.</span>
      </h2>

      <div class="founder__letter">
        <p>For four years, I bootstrapped a startup.</p>
        <p class="founder__strong">I spent my whole savings. I sold my gold. I sold my property.</p>
        <p>Still, I wasn't able to make it a sustainable business. But I know exactly what blocked me.</p>
        <p>
          I want to solve exactly that problem for the new generation of entrepreneurs, and help
          create 1 million sustainable businesses. That is why I am building SoloFactory AI.
        </p>
      </div>

      <p class="founder__sign">
        <span class="founder__name">Rajesh Dayalan</span>
        <span class="founder__role">Founder, SoloFactory AI</span>
      </p>
      <a class="text-link founder__more" href={routes.about}>Read our story <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .founder__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(40px, 7vw, 112px);
  }

  .founder__photo {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    box-shadow: var(--shadow-1);
    aspect-ratio: 4 / 5;
  }

  .founder__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .founder__letter {
    display: grid;
    gap: 18px;
    max-width: 58ch;
    margin-top: 32px;
    color: var(--text-secondary);
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.7;
  }

  .founder__strong {
    color: var(--text);
    font-weight: 600;
  }

  .founder__sign {
    display: grid;
    gap: 2px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .founder__more {
    margin-top: 24px;
  }

  .founder__name {
    font-size: 18px;
    font-weight: 600;
  }

  .founder__role {
    color: var(--text-secondary);
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .founder__inner {
      grid-template-columns: 1fr;
    }

    .founder__side {
      width: 100%;
      max-width: 340px;
    }
  }
</style>
