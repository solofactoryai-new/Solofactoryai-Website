---
import Icon, { type IconName } from "./Icon.astro";

const ideas: { icon: IconName; name: string; text: string }[] = [
  {
    icon: "coins",
    name: "Technology and Growth Credits",
    text: "We are exploring ways to provide AI, cloud, software and marketing credits to entrepreneurs who need resources to keep building and growing.",
  },
  {
    icon: "heart",
    name: "Entrepreneur Support",
    text: "We are exploring targeted support for founders facing financial difficulties, based on transparent eligibility, business progress and responsible governance.",
  },
  {
    icon: "store",
    name: "Product and Business Marketplace",
    text: "We want to help entrepreneurs showcase their products and businesses, reach customers, attract potential partners and become discoverable to investors or potential acquirers.",
  },
];
---

<section class="section section--grey ecosystem" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">More than software. An entrepreneur ecosystem.</p>
      <h2 class="h2" id="ecosystem-title">
        We Want Entrepreneurs to Succeed. <span class="soft">Not Just Subscribe.</span>
      </h2>
      <p class="lead">
        Software alone does not keep a business alive. Over time, we want SoloFactory AI to become
        an ecosystem around the entrepreneur.
      </p>
    </div>

    <ul class="ecosystem__list">
      {ideas.map((idea) => (
        <li class="ecosystem__item" data-reveal>
          <span class="ecosystem__icon"><Icon name={idea.icon} size={24} /></span>
          <span class="chip">In development</span>
          <h3 class="h3">{idea.name}</h3>
          <p class="muted">{idea.text}</p>
        </li>
      ))}
    </ul>

    <p class="ecosystem__note" data-reveal>
      <Icon name="clock" size={18} />
      These are long-term initiatives we are developing. They are not available yet, and no one
      can apply for credits, support or a marketplace listing today.
    </p>
  </div>
</section>

<style>
  .ecosystem__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
  }

  .ecosystem__item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 14px;
    padding: clamp(28px, 3.5vw, 44px);
    background: var(--bg);
  }

  .ecosystem__icon {
    display: grid;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--text);
  }

  .ecosystem__item .muted {
    font-size: 16px;
  }

  .ecosystem__note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 70ch;
    margin-top: 28px;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .ecosystem__note :global(svg) {
    flex: none;
    margin-top: 3px;
  }

  @media (max-width: 900px) {
    .ecosystem__list {
      grid-template-columns: 1fr;
    }
  }
</style>
