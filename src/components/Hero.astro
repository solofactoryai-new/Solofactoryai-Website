---
/* The page opens with the founder's vision statement (SoloFactory AI Vision and Mission
   Statements), then the brand line and the calls to action. */
import HeroVisual from "./HeroVisual.astro";
import Icon from "./Icon.astro";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="chip hero__tag">One entrepreneur. One connected Brain. An entire AI workforce.</p>
      <p class="hero__label">Our vision</p>
      <h1 class="display hero__title" id="hero-title">
        Imagine a world where anyone can own a company <span class="soft">that pays them.</span>
      </h1>
      <p class="hero__lines">
        <span>With or without a job.</span>
        <span>With or without a team.</span>
        <span>With the leverage of AI.</span>
      </p>
      <p class="lead hero__lead">
        So everyone has the freedom to spend more time living the life they love.
      </p>
      <p class="hero__brand">Build Your Business. Not Your Team.</p>
      <div class="hero__ctas">
        <a class="button" href="#join">Get Early Access <Icon name="arrow-right" /></a>
        <a class="button button--secondary" href="#problem">Discover SoloFactory</a>
      </div>
      <p class="hero__for muted">
        For founders of software, AI, physical products, ecommerce, services, agencies and more.
      </p>
    </div>
    <div class="hero__visual">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 104px);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }

  .hero__tag {
    margin-bottom: 28px;
    padding: 4px 12px;
    font-size: 13px;
    white-space: normal;
  }

  .hero__label {
    margin-bottom: 12px;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 550;
  }

  .hero__title {
    max-width: 16ch;
    font-size: clamp(36px, 5vw, 62px);
  }

  .hero__lines {
    display: grid;
    gap: 2px;
    margin-top: 24px;
    font-size: clamp(18px, 1.7vw, 21px);
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    margin-top: 14px;
  }

  .hero__brand {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .hero__for {
    margin-top: 20px;
    font-size: 14px;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }
  }
</style>
