---
import Icon, { type IconName } from "./Icon.astro";

const choices: { icon: IconName; text: string }[] = [
  { icon: "key", text: "Build a sustainable business and operate it independently." },
  { icon: "trending-up", text: "Grow through organic or paid customer acquisition." },
  { icon: "package", text: "Expand your product and your customer base." },
  { icon: "users", text: "Discover partnerships and investment opportunities." },
  { icon: "store", text: "Explore selling your product or business, if the right acquisition opportunity comes." },
];
---

<section class="section ownership" aria-labelledby="ownership-title">
  <div class="container ownership__grid">
    <div class="section-head ownership__head" data-reveal>
      <p class="eyebrow">Ownership and opportunity</p>
      <h2 class="h2" id="ownership-title">
        Build It. Grow It. <span class="soft">Own It.</span>
      </h2>
      <p class="lead">
        Entrepreneurs should have choices. The business you build is yours, and so is the decision
        about what it becomes.
      </p>
    </div>

    <div>
      <ul class="ownership__list">
        {choices.map((c) => (
          <li class="ownership__item" data-reveal>
            <span class="ownership__icon"><Icon name={c.icon} size={20} /></span>
            <span>{c.text}</span>
          </li>
        ))}
      </ul>
      <blockquote class="ownership__quote" data-reveal>
        <p>
          Success doesn't have only one definition. Build something valuable, own your journey and
          choose what comes next.
        </p>
      </blockquote>
      <p class="ownership__fine" data-reveal>
        Every path depends on your business. SoloFactory AI does not promise investment, funding,
        an acquisition or an exit.
      </p>
    </div>
  </div>
</section>

<style>
  .ownership__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .ownership__head {
    margin-bottom: 0;
  }

  .ownership__list {
    display: grid;
  }

  .ownership__item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ownership__icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: var(--action);
    color: #fff;
  }

  .ownership__quote {
    margin: 40px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--text);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .ownership__fine {
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .ownership__grid {
      grid-template-columns: 1fr;
    }

    .ownership__item {
      align-items: flex-start;
      font-size: 17px;
    }
  }
</style>
