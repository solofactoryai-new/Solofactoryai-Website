---
import Icon, { type IconName } from "./Icon.astro";

const pillars: { icon: IconName; name: string; role: string; text: string }[] = [
  {
    icon: "user",
    name: "The Entrepreneur",
    role: "Decides",
    text: "You own the vision, make decisions and control your business.",
  },
  {
    icon: "sparkles",
    name: "The Brain",
    role: "Understands",
    text: "An intelligent system that understands you, your business, your customers, your market and your priorities.",
  },
  {
    icon: "users",
    name: "The AI Workforce",
    role: "Executes",
    text: "Specialised AI Workers that help research, plan, execute authorised tasks and move your business forward.",
  },
];
---

<section class="section section--mist solution" id="how-it-works" aria-labelledby="solution-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Our solution</p>
      <h2 class="h2" id="solution-title">
        An Entire Company. <span class="serif">Powered by AI.</span>
      </h2>
      <p class="lead">
        Three parts work as one. You stay in charge. The Brain keeps the whole picture. The
        workforce does the work you approve.
      </p>
    </div>

    <div class="solution__panel dark" data-reveal>
      <div class="solution__glow" aria-hidden="true"></div>
      <ol class="solution__pillars">
        {pillars.map((p, i) => (
          <li class:list={["solution__pillar", { "solution__pillar--brain": i === 1 }]}>
            <span class="solution__icon"><Icon name={p.icon} size={26} /></span>
            <p class="solution__role">{p.role}</p>
            <h3 class="h3 solution__name">{p.name}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
      <p class="solution__rule">
        <Icon name="shield" size={18} />
        Nothing happens on your behalf without your approval.
      </p>
    </div>
  </div>
</section>

<style>
  .solution__panel {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--navy-900), var(--ink));
    box-shadow: 0 40px 80px -40px rgba(11, 17, 36, 0.55);
  }

  .solution__glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(124, 139, 255, 0.28), transparent);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .solution__pillars {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .solution__pillars::before {
    content: "";
    position: absolute;
    top: 32px;
    right: 16%;
    left: 16%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.7), transparent);
  }

  .solution__pillar {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }

  .solution__icon {
    display: grid;
    width: 64px;
    height: 64px;
    margin-bottom: 14px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: var(--navy-800);
    color: #c7ccff;
  }

  .solution__pillar--brain .solution__icon {
    border-color: transparent;
    background: var(--glow);
    color: #fff;
    box-shadow: 0 0 0 8px rgba(124, 139, 255, 0.12), 0 16px 40px -10px rgba(124, 139, 255, 0.7);
  }

  .solution__role {
    color: #a5acff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .solution__name {
    font-size: 22px;
  }

  .solution__pillar .muted {
    max-width: 32ch;
    font-size: 16px;
  }

  .solution__rule {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 28px;
    border-top: 1px solid var(--line-dark);
    color: var(--muted-on-dark);
    font-size: 15px;
    text-align: center;
  }

  @media (max-width: 820px) {
    .solution__pillars {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* Stacked, a connecting line would run through the text. */
    .solution__pillars::before {
      display: none;
    }
  }
</style>
