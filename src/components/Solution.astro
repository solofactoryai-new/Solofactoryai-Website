---
import Icon, { type IconName } from "./Icon.astro";

const pillars: { icon: IconName; name: string; role: string; text: string }[] = [
  {
    icon: "user",
    name: "The Entrepreneur",
    role: "Decides",
    text: "You own the vision, make decisions and control your business.",
  },
  {
    icon: "sparkles",
    name: "The Brain",
    role: "Understands",
    text: "An intelligent system that understands you, your business, your customers, your market and your priorities.",
  },
  {
    icon: "users",
    name: "The AI Workforce",
    role: "Executes",
    text: "Specialised AI Workers that help research, plan, execute authorised tasks and move your business forward.",
  },
];
---

<section class="section solution" id="how-it-works" aria-labelledby="solution-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Our solution</p>
      <h2 class="h2" id="solution-title">
        An Entire Company. <span class="soft">Powered by AI.</span>
      </h2>
      <p class="lead">
        Three parts work as one. You stay in charge. The Brain keeps the whole picture. The
        workforce does the work you approve.
      </p>
    </div>

    <div class="solution__panel" data-reveal>
            <ol class="solution__pillars">
        {pillars.map((p, i) => (
          <li class:list={["solution__pillar", { "solution__pillar--brain": i === 1 }]}>
            <span class="solution__icon"><Icon name={p.icon} size={26} /></span>
            <p class="solution__role">{p.role}</p>
            <h3 class="h3 solution__name">{p.name}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
      <p class="solution__rule">
        <Icon name="shield" size={18} />
        Nothing happens on your behalf without your approval.
      </p>
    </div>
  </div>
</section>

<style>
  .solution__panel {
    padding: clamp(32px, 5vw, 56px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow: var(--shadow-1);
  }

  .solution__pillars {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .solution__pillars::before {
    content: "";
    position: absolute;
    top: 28px;
    right: 16%;
    left: 16%;
    border-top: 1px dashed #c4c4c4;
  }

  .solution__pillar {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  .solution__icon {
    display: grid;
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
  }

  .solution__pillar--brain .solution__icon {
    border-color: var(--action);
    background: var(--action);
    color: #fff;
    box-shadow: var(--shadow-2);
  }

  .solution__role {
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 550;
  }

  .solution__name {
    font-size: 20px;
  }

  .solution__pillar .muted {
    max-width: 32ch;
  }

  .solution__rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 15px;
    text-align: center;
  }

  @media (max-width: 820px) {
    .solution__pillars {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    /* Stacked, a connecting line would run through the text. */
    .solution__pillars::before {
      display: none;
    }
  }
</style>
