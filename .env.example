# Copy to .env for local builds, or set these in your host's build settings.

# The public address of the site (canonical and social links). Default: https://solofactory.ai
SITE_URL=https://solofactory.ai

# Where the early-access form sends its JSON (POST). Leave empty until a service is chosen:
# the form then validates but tells the visitor honestly that sign-up is not connected yet.
# See README, "The early-access form".
PUBLIC_WAITLIST_ENDPOINT=
